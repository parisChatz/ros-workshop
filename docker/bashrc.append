
# ---- ROS 2 lecture environment ----
source /opt/ros/jazzy/setup.bash
if [ -f "$HOME/workspace/install/setup.bash" ]; then
    source "$HOME/workspace/install/setup.bash"
fi
source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash 2>/dev/null || true
export TURTLEBOT3_MODEL=${TURTLEBOT3_MODEL:-waffle}

alias cb='cd ~/workspace && colcon build --symlink-install && source install/setup.bash'
alias tb3world='ros2 launch turtlebot3_gazebo turtlebot3_world.launch.py'
alias tb3empty='ros2 launch turtlebot3_gazebo empty_world.launch.py'
alias tb3teleop='ros2 run turtlebot3_teleop teleop_keyboard'
